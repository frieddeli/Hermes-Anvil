#!/bin/bash
# Hermes Anvil VM startup script -- rendered by gcp/compute.py and passed
# as instance metadata.
#
# IMPORTANT: GCP re-runs the `startup-script` metadata on EVERY boot, not
# just at instance creation -- this is not a "runs once" hook by default.
# Without a persistent-storage guard, this script would re-install Hermes,
# clobber any config.yaml customization the user made (like uncommenting
# the Workspace MCP block), and race against the already-enabled systemd
# unit on every subsequent reboot. The marker file below makes everything
# past this point a true one-time provisioning step.
set -euo pipefail

PROVISIONED_MARKER="/var/lib/hermes-anvil-provisioned"
if [ -f "${PROVISIONED_MARKER}" ]; then
  echo "Already provisioned (marker: ${PROVISIONED_MARKER}) -- skipping re-provisioning on this boot."
  exit 0
fi

PROJECT="{{ project }}"
SECRET_NAME="{{ secret_name }}"
AGENT_NAME="{{ agent_name }}"

exec > /var/log/hermes-anvil-startup.log 2>&1
echo "=== Hermes Anvil startup: $(date -u) ==="

# --- 1. Dedicated non-root user for Hermes ---
if ! id hermes &>/dev/null; then
  useradd -m -s /bin/bash hermes
fi

# --- 2. Fetch the user's model-provider API key from Secret Manager ---
# Only the secret NAME lives in this script (see docs/security.md,
# measure 3) -- the value is fetched here, at boot, via the VM's own
# attached least-privilege service account (metadata-server-based
# credentials, no key file involved), and is never written to disk in
# cleartext anywhere else.
API_KEY=$(gcloud secrets versions access latest --secret="${SECRET_NAME}" --project="${PROJECT}")

# --- 3. Install Hermes Agent ---
# Installer sets up Python 3.11+/Node/uv/ripgrep/ffmpeg itself.
sudo -u hermes bash -c 'curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash'

# The installer appends hermes to PATH via shell rc files (its own
# quickstart docs say to `source ~/.bashrc` afterward) rather than
# making it available to non-interactive/non-login processes. systemd
# does not source .bashrc, so resolve the real binary path explicitly
# now and use that full path below instead of a bare `hermes` -- avoids
# a silent "command not found" the first time the service starts.
HERMES_BIN=$(sudo -u hermes bash -lc 'command -v hermes' || true)
if [ -z "${HERMES_BIN}" ]; then
  echo "ERROR: hermes binary not found on PATH after install. Aborting." >&2
  exit 1
fi
echo "Resolved hermes binary: ${HERMES_BIN}"

# --- 4. Configure Hermes ---
# Verified against Hermes's own docs (hermes-agent.nousresearch.com/docs):
# `hermes config set <KEY> <VALUE>` is the real mechanism for API keys --
# it routes automatically to ~/.hermes/.env, not into config.yaml. This
# assumes OpenRouter (this project's recommended default provider, see
# docs/prerequisites.md) -- OPENROUTER_API_KEY is confirmed correct for
# that provider. If the attendee used Nous Portal or OpenAI instead, this
# key name is wrong; the harness doesn't currently ask which provider was
# used, so it can't select the right key name for those cases. Known gap,
# see docs/dev-guide.md.
sudo -u hermes bash -lc "'${HERMES_BIN}' config set OPENROUTER_API_KEY '${API_KEY}'"
unset API_KEY

sudo -u hermes mkdir -p /home/hermes/.hermes
cat <<EOF > /home/hermes/.hermes/config.yaml
agent_name: "${AGENT_NAME}"

# --- Optional: Google Workspace MCP (Gmail / Calendar / Drive / Chat) ---
# Uncomment the products you want to give your agent access to, via
# Google's official per-product Workspace MCP servers (there is no
# single unified "Workspace MCP" endpoint -- each product has its own
# dedicated server; URLs verified live, see
# https://developers.google.com/workspace/guides/configure-mcp-servers
# for the full list and auth setup). Not infra control (unlike the
# self-management wiring below), so it's safe to enable if you want it.
# mcp_servers:
#   gmail:
#     url: "https://gmailmcp.googleapis.com/mcp/v1"
#     auth: oauth
#   calendar:
#     url: "https://calendarmcp.googleapis.com/mcp/v1"
#     auth: oauth
#   drive:
#     url: "https://drivemcp.googleapis.com/mcp/v1"
#     auth: oauth
#   chat:
#     url: "https://chatmcp.googleapis.com/mcp/v1"
#     auth: oauth

# --- Optional, v2, NOT recommended on day one (docs/security.md) ---
# Wiring your agent to the Compute Engine MCP server would let it
# inspect/manage its own VM (and other Compute resources in this
# project) directly. That's real infrastructure control handed to an
# autonomous agent -- deliberately left out of the default setup. Add
# it yourself later once you've gotten a feel for how your agent behaves.
# mcp_servers:
#   gcp-compute:
#     url: "https://compute.googleapis.com/mcp"
#     auth: oauth
EOF
chown hermes:hermes /home/hermes/.hermes/config.yaml
chmod 600 /home/hermes/.hermes/config.yaml

# --- 5. Block the agent from reaching the GCP metadata server ---
# (docs/security.md, measure 6). Implemented as a plain iptables rule
# scoped to the `hermes` user's UID, not via OpenShell's network policy
# layer -- see the OpenShell section below for why. This works
# regardless of whether OpenShell installs successfully or what mode
# it's running in, and can be enabled unconditionally rather than
# gated behind an audit/enforce toggle.
#
# Guarded on iptables actually existing: recent Debian images increasingly
# default to nftables-only. Under `set -euo pipefail`, an unguarded
# missing-command failure here would abort the ENTIRE script, taking
# down OpenShell setup and the systemd unit below with it -- not just
# this one optional protection. Non-fatal if missing, same pattern as
# the OpenShell install below.
if command -v iptables &>/dev/null; then
  HERMES_UID=$(id -u hermes)
  iptables -A OUTPUT -d 169.254.169.254 -m owner --uid-owner "${HERMES_UID}" -j DROP
  echo "Blocked hermes user (uid ${HERMES_UID}) from reaching the metadata server."
else
  echo "WARNING: iptables not found -- metadata-server block (security.md measure 6) not applied."
fi

# --- 6. NVIDIA OpenShell sandbox (docs/security.md, measure 5) ---
# Wraps Hermes's execution: Landlock LSM filesystem restriction + a
# scoped process identity. Runs in AUDIT mode by default -- observe
# what Hermes's tools actually touch during pre-release testing, then
# flip OPENSHELL_MODE to "enforce" once a working policy has been
# validated against a real run. Do NOT ship "enforce" without a full
# rehearsal first -- an over-strict policy can silently break a Hermes
# tool mid-demo.
#
# NOTE on scope: this policy intentionally covers filesystem and
# process identity only, NOT network. OpenShell's real network policy
# model (network_policies: a named block per endpoint+binary, deny by
# default for anything unmatched -- verified against
# https://docs.nvidia.com/openshell/sandboxes/policies) is an allowlist
# model that doesn't fit this project's permissive-by-default network
# stance (docs/security.md's "guiding principle": Hermes needs to reach
# arbitrary MCP servers/APIs the user adds later, which can't be
# enumerated in advance). Network-layer control instead comes from the
# VPC egress firewall (measure 4, permissive-by-default with a targeted
# denylist) plus the iptables rule above for the one specific thing
# worth always blocking. Revisit adding network_policies here only if a
# real run shows OpenShell supports a genuine default-allow mode for it.
OPENSHELL_MODE="audit"
OPENSHELL_AVAILABLE=0

# Official installer (verified reachable at authoring time -- confirm
# still current before shipping, installers can move):
# https://docs.nvidia.com/openshell/about/installation
# Detects the OS and installs the openshell CLI + openshell-gateway
# daemon + systemd user service via the native package manager. Non-fatal
# if it fails -- Hermes must still come up even if sandboxing doesn't.
if curl -LsSf https://raw.githubusercontent.com/NVIDIA/OpenShell/main/install.sh | sh; then
  :
else
  echo "WARNING: OpenShell install failed -- continuing without sandboxing."
fi

if command -v openshell &>/dev/null; then
  OPENSHELL_AVAILABLE=1
else
  echo "NOTE: openshell not found on this image after install attempt. Hermes will run unsandboxed."
fi

mkdir -p /etc/openshell
cat <<'POLICY' > /etc/openshell/hermes-policy.yaml
# Schema verified against https://docs.nvidia.com/openshell/sandboxes/policies
# at authoring time -- confirm still current before relying on this,
# field names could still drift with newer OpenShell releases.
version: 1
filesystem_policy:
  read_write:
    - /home/hermes
  read_only:
    - /usr
    - /lib
    - /etc
landlock:
  compatibility: best_effort   # switch to hard_requirement once tuned, see above
process:
  run_as_user: hermes
  run_as_group: hermes
POLICY

# --- 7. systemd unit ---
if [ "${OPENSHELL_AVAILABLE}" = "1" ]; then
  EXEC_START="/usr/bin/env openshell run --policy=/etc/openshell/hermes-policy.yaml --mode=${OPENSHELL_MODE} -- ${HERMES_BIN} gateway"
else
  EXEC_START="${HERMES_BIN} gateway"
fi

cat <<EOF > /etc/systemd/system/hermes-agent.service
[Unit]
Description=Hermes Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/home/hermes
ExecStart=${EXEC_START}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now hermes-agent.service

touch "${PROVISIONED_MARKER}"
echo "=== Hermes Anvil startup finished: $(date -u) ==="
