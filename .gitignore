# Python build/test artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
dist/
build/
*.egg
.ruff_cache/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store

# Credentials -- defensive, in case of local testing against real GCP.
# Nothing in this codebase writes these by design (secrets are meant to
# live only in Secret Manager, never on disk -- see docs/security.md),
# but a developer manually running `gcloud iam service-accounts keys
# create` or similar during real-GCP testing shouldn't be one `git add .`
# away from committing it.
.env
.env.*
*.pem
*.key
*-key.json
*service-account*.json
*credentials*.json
application_default_credentials.json
# pixi -- local-only scratch environment for testing gcloud/gcloud-mcp
# during development (needs the real gcloud CLI, which this project's
# own dependencies don't include). Not part of the product -- keep the
# whole thing, manifest included, out of the repo entirely.
.pixi/*
!.pixi/config.toml
pixi.toml
pixi.lock
.gitattributes

# Local Claude Code project config, if one ever gets added -- personal
# dev tooling, not part of the product.
.claude/

# Playwright MCP debugging artifacts (screenshots/snapshots/logs from
# ad hoc local browser-automation testing) -- scratch output, not part
# of the product.
.playwright-mcp/
